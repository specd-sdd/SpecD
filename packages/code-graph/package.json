{
  "name": "@specd/code-graph",
  "version": "0.3.0",
  "license": "MIT",
  "private": false,
  "repository": "https://github.com/specd-sdd/SpecD",
  "homepage": "https://getspecd.dev",
  "files": [
    "dist/"
  ],
  "type": "module",
  "dependencies": {
    "@ast-grep/lang-go": "^0.0.5",
    "@ast-grep/lang-php": "^0.0.6",
    "@ast-grep/lang-python": "^0.0.5",
    "@ast-grep/napi": "^0.41.1",
    "@specd/core": "workspace:*",
    "better-sqlite3": "^12.8.0",
    "ignore": "^7.0.0"
  },
  "exports": {
    ".": {
      "import": "./dist/public.js",
      "types": "./dist/public.d.ts"
    },
    "./internal": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/public.ts src/index.ts --format esm --dts --clean",
    "build:dev": "tsup src/public.ts src/index.ts --format esm --dts --sourcemap --clean",
    "build:debug": "tsup src/public.ts src/index.ts --format esm --dts --sourcemap --clean",
    "dev": "tsup src/public.ts src/index.ts --format esm --dts --sourcemap --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "release:publish": "pnpm publish --access public",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13"
  }
}
